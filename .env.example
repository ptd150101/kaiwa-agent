# Speech layer: required for the voice demo.
SONIOX_API_KEY=replace-me
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE=Maya
SONIOX_TTS_SPEED=0.92

# Any OpenAI-compatible chat-completions endpoint.
# Cloud example: leave LLM_BASE_URL empty and use the provider's API key.
# Local example: LLM_BASE_URL=http://127.0.0.1:8000/v1 and LLM_API_KEY=local.
LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.45

# PoC session configuration.
KAIWA_USER_ID=demo-user
KAIWA_SCENARIO_ID=lunch_with_colleague_n4
KAIWA_LEVEL=N4
KAIWA_FEEDBACK_MODE=delayed
KAIWA_DB_PATH=var/kaiwa.db
KAIWA_COACH_MODE=llm

